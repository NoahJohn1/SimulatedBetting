# Committed template — the only .env file tracked in git (see .gitignore). Copy the values you
# need into .env.local (local dev), .env.test (the test suite), or .env.production (production
# migrations only) — see the header comment in each of those for what loads it and when.

# Local Postgres, from `docker compose up` (npm run db:up). Read by `next dev`, `next build`,
# `next start`, drizzle-kit, and `npm run db:migrate` by default (ENV_FILE overrides the target,
# e.g. `ENV_FILE=.env.production npm run db:migrate` for the one-off production migration run —
# see docs/roadmap.md). Never the source of a production connection string.
DATABASE_URL=postgres://simbet:simbet@localhost:5433/simbet
# Unused by application code — the suite reads DATABASE_URL from .env.test instead. Kept
# because CI sets it and removing it is a separate change.
TEST_DATABASE_URL=postgres://simbet:simbet@localhost:5433/simbet_test

# Auth.js. Generate with: openssl rand -base64 32
# Vercel needs its own value — Noah can generate a fresh one himself, it does not need to match.
AUTH_SECRET=

# From the Google Cloud Console OAuth client. Vercel needs the SAME client's ID and secret as
# local dev — a second OAuth client would need its own consent screen and its own review of
# ADMIN_EMAILS below. Whoever owns that Google Cloud project shares these two values for Vercel,
# and adds the production callback URL to that client's Authorized redirect URIs:
#   https://<production-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated addresses that arrive as approved admins, which is how the first
# admin gets in — nobody exists yet to approve them. Everyone else waits in the queue.
# Vercel can reuse the same list, or add more addresses once real members are known.
ADMIN_EMAILS=

# Shared secret for the cron routes, which move money. Generate the same way.
# Callers send it as: Authorization: Bearer <CRON_SECRET>
# Noah can generate his own value independently — it only has to match what he sets as the
# GitHub Actions repo secret of the same name (.github/workflows/cron.yml calls sync-odds and
# settle with it), and Vercel Cron reads its own CRON_SECRET env var automatically for the
# crons already declared in vercel.json (allowance, reconcile, notify).
CRON_SECRET=

# Absolute origin of the deployment, used as metadataBase so icons and the manifest resolve.
# Defaults to http://localhost:3000 when unset.
# Noah's own value in Vercel — the production URL. Also what the roadmap calls out as needed
# alongside AUTH_URL and the OAuth redirect for "Vercel wiring" (roadmap phase 6).
NEXT_PUBLIC_SITE_URL=

# Real odds/score adapter. "espn" pulls live NFL/CFB slates and lines from ESPN's public
# JSON. Unset, or anything else, uses the fixture providers — the safe default with zero
# external calls.
# Noah sets this to "espn" in Vercel for the production cutover (roadmap phase 5) — a fixed
# string, no coordination needed.
ODDS_PROVIDER=

# Optional. Where cron failures and reconciliation drift are announced. A Discord or Slack
# incoming-webhook URL — the payload carries both `content` and `text`, so either works (D59).
# Unset, alerts are logged and not sent, which is the expected state in CI and locally.
# Noah creates this webhook himself, in a Discord/Slack channel he controls (roadmap phase 6).
ALERT_WEBHOOK_URL=

# Optional. Sentry. Unset, Sentry.init is never called and nothing reports (D62).
# Noah's own Sentry signup (roadmap phase 6) — these come from his Sentry project settings once
# he creates one.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional. Only for source-map upload at build time. Without it the build warns and succeeds.
# Also from Noah's Sentry project, once it exists.
SENTRY_AUTH_TOKEN=

# Transactional email. Unset means the console transport: every message is logged and nothing
# is sent, which is the expected state in CI, in the test suite, and in local development.
# Get a key at resend.com; the free tier is 3,000/month and 100/day.
# Noah's own Resend signup (roadmap phase 8) — his account, his key.
RESEND_API_KEY=

# The From header on every message. Must be an address on a domain verified with the provider.
# Defaults to Resend's onboarding@resend.dev, which only delivers to the account owner.
# Noah's own value, once he verifies a sending domain with Resend.
EMAIL_FROM=
